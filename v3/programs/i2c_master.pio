; I2C master, 9-bit transfers: host entry (FIFO16) = byte<<8 | ackbit<<7, MSB first.
; SDA = G0, SCL = G1 (open-drain via the global OD mask). Pushes the 9 sampled bits.
; Entries: start (0), byte loop (5), stop (13). Clock stretching via wait on SCL.
.program i2c_master
.side_set 1 opt
start:
    set pins, 1     side 0 [3]   ; SDA high, SCL low
    nop             side 1 [3]   ; SCL high
    wait 1 pin 1                  ; (stretching)
    set pins, 0     side 1 [3]   ; SDA falls while SCL high: START
    nop             side 0 [3]   ; SCL low
byte:
    set x, 8                      ; 9 bits
bit:
    out pins, 1     side 0 [3]   ; data bit while SCL low (autopull 9)
    nop             side 1 [1]   ; release SCL
    wait 1 pin 1                  ; wait until SCL really high (stretching)
    in pins, 1      side 1 [1]   ; sample SDA
    jmp x-- bit     side 0 [3]
    push                          ; 9 bits: data[8:1], ack[0]
    jmp byte
stop:
    set pins, 0     side 0 [3]   ; SDA low, SCL low
    nop             side 1 [3]   ; SCL high
    wait 1 pin 1
    set pins, 1     side 1 [3]   ; SDA rises while SCL high: STOP
done:
    jmp done
