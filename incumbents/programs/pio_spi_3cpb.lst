# spi_3cpb: PIO, 18 words; GRPS=0x28100400 PEND=0x00011000 SHIFT=0x00000000 DIV=0x00000100 IMM=0xE083
00: 80a0  pull block side 0
01: 6101  out pins, 1 side 0 [1]
02: 5001  in pins, 1 side 1
03: 6101  out pins, 1 side 0 [1]
04: 5001  in pins, 1 side 1
05: 6101  out pins, 1 side 0 [1]
06: 5001  in pins, 1 side 1
07: 6101  out pins, 1 side 0 [1]
08: 5001  in pins, 1 side 1
09: 6101  out pins, 1 side 0 [1]
10: 5001  in pins, 1 side 1
11: 6101  out pins, 1 side 0 [1]
12: 5001  in pins, 1 side 1
13: 6101  out pins, 1 side 0 [1]
14: 5001  in pins, 1 side 1
15: 6101  out pins, 1 side 0 [1]
16: 5001  in pins, 1 side 1
17: 8020  push block side 0
